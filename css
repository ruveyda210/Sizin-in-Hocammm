* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;
    overflow: hidden;

    background: linear-gradient(
        135deg,
        #ff69b4,
        #ff1493,
        #ff4d6d,
        #ffb6c1
    );

    background-size: 400% 400%;
    animation: renkler 8s ease infinite;
}

@keyframes renkler {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

.ekran {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    position: relative;
}

.gizli {
    display: none;
}

.kutu {
    width: 500px;
    padding: 55px 40px;

    text-align: center;

    background: rgba(255, 255, 255, 0.96);

    border: 5px solid #ff4d88;
    border-radius: 35px;

    box-shadow:
        0 0 20px #ff69b4,
        0 0 40px #ff1493,
        0 15px 40px rgba(0, 0, 0, 0.25);

    position: relative;
    z-index: 2;
}

h1 {
    color: #e91e63;
    font-size: 40px;
    margin-bottom: 25px;
}

h2 {
    color: #e91e63;
    font-size: 36px;
    margin: 25px 0;
}

p {
    color: #d81b60;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 35px;
}

button {
    background: linear-gradient(45deg, #ff1493, #ff4d6d);

    color: white;

    border: none;
    border-radius: 50px;

    padding: 18px 40px;

    font-size: 24px;
    font-weight: bold;

    cursor: pointer;

    box-shadow: 0 8px 20px rgba(255, 20, 147, 0.4);

    transition: 0.3s;
}

button:hover {
    transform: scale(1.1);

    box-shadow:
        0 0 20px #ff1493,
        0 0 40px #ff69b4;
}

.kalp {
    position: absolute;
    font-size: 60px;

    animation: kalpUcus 4s infinite ease-in-out;

    z-index: 1;
}

.kalp1 {
    top: 10%;
    left: 10%;
}

.kalp2 {
    top: 20%;
    right: 12%;
    animation-delay: 1s;
}

.kalp3 {
    bottom: 15%;
    left: 15%;
    animation-delay: 2s;
}

.kalp4 {
    bottom: 10%;
    right: 15%;
    animation-delay: 3s;
}

@keyframes kalpUcus {
    0% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-30px) rotate(15deg);
    }

    100% {
        transform: translateY(0) rotate(0deg);
    }
}